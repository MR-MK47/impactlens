# ═══════════════════════════════════════════════════════════════
# ImpactLens — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────
# SUPABASE (Required)
# ──────────────────────────────────────────────────────
# 1. Go to https://supabase.com → Create a new project
# 2. Go to Project Settings → API
# 3. Copy "Project URL" and "anon public" key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ──────────────────────────────────────────────────────
# GEMINI AI (Required for image analysis & blog generation)
# ──────────────────────────────────────────────────────
# 1. Go to https://aistudio.google.com/apikey
# 2. Click "Create API Key"
# 3. Copy the key
VITE_GEMINI_API_KEY=

# ──────────────────────────────────────────────────────
# WACRM — WhatsApp CRM (Required for WhatsApp features)
# ──────────────────────────────────────────────────────
# WACRM is integrated into ImpactLens but connects to your
# WhatsApp Business API via Meta Cloud API.
#
# 1. Go to https://developers.facebook.com
# 2. Create a Business App → Add WhatsApp product
# 3. Get a permanent access token from Business Settings
# 4. Get your WhatsApp Business Account ID and Phone Number ID
#    from the WhatsApp → API Setup page
VITE_WHATSAPP_ACCESS_TOKEN=
VITE_WHATSAPP_PHONE_NUMBER_ID=
VITE_WHATSAPP_BUSINESS_ACCOUNT_ID=

# ──────────────────────────────────────────────────────
# APP CONFIG
# ──────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:3001
